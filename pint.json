{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "final_class": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "ordered_class_elements": true,
        "no_unused_imports": true,
        "concat_space": {
            "spacing": "one"
        },
        "not_operator_with_successor_space": false,
        "phpdoc_align": {
            "align": "left"
        }
    },
    "exclude": [
        "database"
    ]
}
